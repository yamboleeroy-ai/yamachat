{
  "appId": "eu.yamachat.app",
  "appName": "Yamachat",
  "webDir": "www",
  "backgroundColor": "#071019",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": false,
      "backgroundColor": "#071019",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#071019",
      "style": "LIGHT"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge"
      ]
    },
    "LocalNotifications": {
      "smallIcon": "ic_yamachat_notification",
      "iconColor": "#E056FD",
      "sound": "yamachat_message.mp3",
      "presentationOptions": [
        "badge",
        "sound",
        "banner",
        "list"
      ]
    }
  }
}
