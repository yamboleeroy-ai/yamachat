<Window x:Class="YamaSearch.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Účet YamaSearch"
        Width="720" Height="790" MinWidth="650" MinHeight="660"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#08111D" Foreground="#EAF3FF"
        Icon="pack://application:,,,/Assets/YamaSearch.ico">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#174B70" BorderThickness="1" CornerRadius="14" Background="#08111D">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/Assets/YamaSearch-symbol-64.png" Width="42" Height="42" Margin="0,0,12,0"/>
          <StackPanel>
            <TextBlock Text="Účet YamaSearch" FontSize="22" FontWeight="SemiBold" Foreground="#42D8FF"/>
            <TextBlock Text="Přihlášení, propojené účty a synchronizace" Style="{StaticResource YamaSubtleText}" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="×" Style="{StaticResource YamaCloseButton}" Click="Close_Click"/>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource YamaScrollBar}"/></ScrollViewer.Resources>
        <StackPanel Margin="0,0,8,0">
          <Border Style="{StaticResource YamaDialogCard}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid Width="58" Height="58" VerticalAlignment="Top">
                <Ellipse Fill="#0E1A2B" Stroke="#2D638E" StrokeThickness="1"/>
                <Viewbox Width="30" Height="30">
                  <Grid Width="24" Height="24">
                    <Ellipse Width="7" Height="7" Canvas.Top="3" Fill="#7DE7FF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <Path Data="M5,21 C5.5,15.5 8,13 12,13 C16,13 18.5,15.5 19,21" Stroke="#7DE7FF" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round"/>
                  </Grid>
                </Viewbox>
                <Ellipse x:Name="AvatarImage" Visibility="Collapsed" Stroke="#42D8FF" StrokeThickness="1">
                  <Ellipse.Fill><ImageBrush x:Name="AvatarImageBrush" Stretch="UniformToFill"/></Ellipse.Fill>
                </Ellipse>
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="DisplayNameText" Text="Nepřihlášený uživatel" FontSize="18" FontWeight="SemiBold" Foreground="#F4F8FF" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="EmailText" Foreground="#AFC5DB" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusText" Foreground="#6EDFFF" Margin="0,7,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <Button x:Name="RetryButton" Grid.Column="2" Content="Zkusit znovu" Style="{StaticResource YamaSecondaryButton}" Click="Retry_Click" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>

          <Border x:Name="SignInCard" Style="{StaticResource YamaDialogCard}">
            <StackPanel>
              <TextBlock Text="Přihlášení" Style="{StaticResource YamaSectionTitle}"/>
              <TextBlock Text="Heslo zadáváte pouze na oficiální stránce vybraného poskytovatele. YamaSearch používá systémový prohlížeč a PKCE."
                         Style="{StaticResource YamaSubtleText}" Margin="0,8,0,12"/>
              <StackPanel x:Name="SignInProvidersPanel"/>
              <TextBlock x:Name="NoProvidersText" Text="Na odděleném serveru YamaSearch zatím není aktivní žádný podporovaný poskytovatel."
                         Style="{StaticResource YamaSubtleText}" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <Border x:Name="LinkedAccountsCard" Style="{StaticResource YamaDialogCard}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Propojené účty" Style="{StaticResource YamaSectionTitle}"/>
              <TextBlock Text="Každé propojení je další ověřený způsob přihlášení ke stejnému profilu YamaSearch."
                         Style="{StaticResource YamaSubtleText}" Margin="0,8,0,12"/>
              <StackPanel x:Name="LinkedAccountsPanel"/>
              <TextBlock Text="Připojit další účet" Foreground="#DDEBFA" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8"/>
              <StackPanel x:Name="LinkProvidersPanel"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource YamaDialogCard}">
            <StackPanel>
              <TextBlock Text="Synchronizace" Style="{StaticResource YamaSectionTitle}"/>
              <TextBlock x:Name="SyncStatusText"
                         Text="Synchronizace není zapnutá. Místní oblíbené, nastavení ani historie se nikam neodesílají."
                         Style="{StaticResource YamaSubtleText}" Margin="0,8,0,0"/>
              <TextBlock Text="Hesla a passkeys se do navržené synchronizace nezahrnují; nadále je chrání WebView2 a Windows."
                         Style="{StaticResource YamaSubtleText}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <Border x:Name="SignedInActionsCard" Style="{StaticResource YamaDialogCard}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Relace a soukromí" Style="{StaticResource YamaSectionTitle}"/>
              <TextBlock Text="Odhlášení odstraní obnovovací token z tohoto zařízení. Běžné prohlížení a místní data zůstanou zachována."
                         Style="{StaticResource YamaSubtleText}" Margin="0,8,0,12"/>
              <Button Content="Odhlásit toto zařízení" Style="{StaticResource YamaDangerButton}" HorizontalAlignment="Left" Click="SignOut_Click"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="YamaSearch lze vždy používat i bez účtu." Style="{StaticResource YamaSubtleText}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Zavřít" Style="{StaticResource YamaPrimaryButton}" Click="Close_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
