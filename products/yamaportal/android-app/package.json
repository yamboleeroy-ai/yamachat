{
  "name": "yamaportal-android",
  "version": "0.2.1",
  "private": true,
  "description": "Samostatná Android aplikace Yamaportal",
  "scripts": {
    "build:web": "node scripts/build-web.mjs && esbuild src/native-bridge.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=www/native-bridge.js",
    "native:init": "npm run build:web && cap add android && node scripts/patch-android.mjs",
    "android:debug": "npm run build:web && cap sync android && node scripts/patch-android.mjs && cd android && gradlew.bat assembleDebug",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.0.2",
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.0.2",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/splash-screen": "8.0.0",
    "@capacitor/status-bar": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.2",
    "esbuild": "0.25.0"
  }
}
