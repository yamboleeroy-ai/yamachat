<Window x:Class="YamaSearch.OnboardingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vítej v YamaSearch" Width="720" Height="720" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0B101A" Foreground="#EAF3FF">
 <Grid Margin="42"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><Image Source="pack://application:,,,/Assets/YamaSearch-brand.png" Width="300" Height="100" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="Vítej v YamaSearch" HorizontalAlignment="Center" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Nastav si prohlížeč podle sebe. Vše můžeš později změnit." Foreground="#A8B9CC" HorizontalAlignment="Center"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,30,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#16243A" CornerRadius="15" Padding="22"><StackPanel><TextBlock Text="Jak chceš hledat?" FontSize="18" FontWeight="SemiBold"/><RadioButton x:Name="Google" Content="Google" Margin="0,14,0,4"/><RadioButton x:Name="Seznam" Content="Seznam" Margin="0,4"/><RadioButton x:Name="Bing" Content="Bing" Margin="0,4"/><RadioButton x:Name="DuckDuckGo" Content="DuckDuckGo" Margin="0,4"/><RadioButton x:Name="BraveSearch" Content="Brave Search" Margin="0,4"/><RadioButton x:Name="Ecosia" Content="Ecosia" Margin="0,4"/><RadioButton x:Name="Yahoo" Content="Yahoo" Margin="0,4"/><RadioButton x:Name="Startpage" Content="Startpage" Margin="0,4"/><RadioButton x:Name="CustomSearch" Content="Vlastní vyhledávač" Margin="0,10,0,4"/><TextBox x:Name="CustomSearchUrl" Text="https://example.com/search?q={query}" ToolTip="Použijte {query} jako zástupný text pro dotaz"/></StackPanel></Border>
   <Border Grid.Column="2" Background="#16243A" CornerRadius="15" Padding="22"><StackPanel><TextBlock Text="Co uvidíš po spuštění?" FontSize="18" FontWeight="SemiBold"/><RadioButton x:Name="NewTab" Content="Nová karta YamaSearch" Margin="0,14,0,4"/><RadioButton x:Name="HomeGoogle" Content="Google" Margin="0,4"/><RadioButton x:Name="HomeSeznam" Content="Seznam" Margin="0,4"/><RadioButton x:Name="CustomHome" Content="Vlastní stránka" Margin="0,10,0,4"/><TextBox x:Name="CustomHomeUrl" Text="https://" ToolTip="Zadejte úplnou HTTPS nebo HTTP adresu"/></StackPanel></Border>
  </Grid>
  <DockPanel Grid.Row="2"><TextBlock Text="YamaBlock a YamaShield jsou při prvním spuštění nastaveny na doporučenou ochranu." Foreground="#A8B9CC" VerticalAlignment="Center" TextWrapping="Wrap" Width="430"/><Button Content="Začít procházet" Background="#087EAA" Padding="18,10" DockPanel.Dock="Right" Click="Finish_Click"/></DockPanel>
 </Grid>
</Window>
