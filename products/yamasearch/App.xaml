<Application x:Class="YamaSearch.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Startup="Application_Startup">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#0B101A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121A27"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#192437"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EAF3FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#96A7BD"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#23C9F5"/>
    <SolidColorBrush x:Key="YamaCardBrush" Color="#14243A"/>
    <SolidColorBrush x:Key="YamaCardHoverBrush" Color="#193555"/>
    <SolidColorBrush x:Key="YamaBorderBrush" Color="#245A84"/>
    <SolidColorBrush x:Key="YamaDangerBrush" Color="#482433"/>
    <SolidColorBrush x:Key="YamaDangerBorderBrush" Color="#A84E65"/>

    <Style x:Key="YamaDialogCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource YamaCardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource YamaBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="YamaSectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F4F8FF"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="YamaSubtleText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9CB4CF"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="YamaPrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#087EAA"/>
      <Setter Property="BorderBrush" Value="#2DD8FF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="YamaSecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="#142A46"/>
      <Setter Property="BorderBrush" Value="#2B628D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Foreground" Value="#EAF3FF"/>
    </Style>

    <Style x:Key="YamaDangerButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource YamaDangerBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource YamaDangerBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Foreground" Value="#FFD5DC"/>
    </Style>

    <Style x:Key="YamaCloseButton" TargetType="Button">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Background" Value="#10243A"/>
      <Setter Property="BorderBrush" Value="#245A84"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#EAF3FF"/>
    </Style>

    <Style x:Key="YamaTextBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="#EAF3FF"/>
      <Setter Property="Background" Value="#0E1A2B"/>
      <Setter Property="BorderBrush" Value="#2D638E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="CaretBrush" Value="#42D8FF"/>
    </Style>

    <Style x:Key="YamaCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EAF3FF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#0E1A2B" BorderBrush="#2D638E" BorderThickness="1" Margin="0,0,9,0">
                <TextBlock x:Name="Mark" Text="✓" Foreground="#42D8FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#123D55"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#42D8FF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="YamaRadioButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#EAF3FF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal">
              <Grid Width="18" Height="18" Margin="0,0,9,0">
                <Ellipse x:Name="Ring" Fill="#0E1A2B" Stroke="#2D638E" StrokeThickness="1"/>
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#42D8FF" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#42D8FF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="YamaComboBox" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#EAF3FF"/>
      <Setter Property="Background" Value="#0E1A2B"/>
      <Setter Property="BorderBrush" Value="#2D638E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid Margin="10,0,8,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                  <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                  <TextBlock Grid.Column="1" Text="⌄" Foreground="#8FDFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                <Border Background="#101D30" BorderBrush="#2D638E" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAF3FF"/>
            <Setter Property="Background" Value="#101D30"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#21496B"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#0C566F"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="YamaScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="#0B1624"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Background="#20C8F3">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="5"/></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#253650"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/><Setter Property="BorderBrush" Value="#2B4262"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="1"/></Style>
  </Application.Resources>
</Application>
