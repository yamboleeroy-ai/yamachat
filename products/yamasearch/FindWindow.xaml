<Window x:Class="YamaSearch.FindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Najít na stránce"
        Width="430" Height="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B101A" Foreground="#EAF3FF"
        Icon="pack://application:,,,/Assets/YamaSearch.ico">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Najít na stránce" FontSize="18" FontWeight="SemiBold"/>
    <TextBox x:Name="QueryBox" Grid.Row="1" Margin="0,12,0,12" KeyDown="QueryBox_KeyDown"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Zrušit" Click="Cancel_Click" Margin="0,0,8,0"/>
      <Button Content="Najít" Background="#087EAA" Click="Find_Click"/>
    </StackPanel>
  </Grid>
</Window>