<Window x:Class="YamaSearch.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YamaSearch – Historie"
        Icon="pack://application:,,,/Assets/YamaSearch.ico"
        Width="940" Height="690" MinWidth="720" MinHeight="520"
        Background="#08111D" Foreground="#EAF3FF"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
  <Border BorderBrush="#174B70" BorderThickness="1" CornerRadius="14" Background="#08111D">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="◷" FontSize="28" Foreground="#42D8FF" Margin="0,0,12,0"/>
          <StackPanel>
            <TextBlock Text="Historie prohlížení" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="Poslední navštívené stránky v YamaSearch" Style="{StaticResource YamaSubtleText}" Margin="0,4,0,0"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="×" Style="{StaticResource YamaCloseButton}" Click="Close_Click"/>
      </Grid>

      <Border Grid.Row="1" Style="{StaticResource YamaDialogCard}" Margin="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource YamaScrollBar}"/></ScrollViewer.Resources>
          <StackPanel x:Name="HistoryList" Margin="0,0,8,0"/>
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="2" Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Jednotlivé položky můžeš otevřít nebo odstranit křížkem vpravo." Style="{StaticResource YamaSubtleText}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Vymazat celou historii" Style="{StaticResource YamaDangerButton}" Click="ClearHistory_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>