<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the browser profile out of both Android 12+ backup paths. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
