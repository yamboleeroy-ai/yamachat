<Window x:Class="YamaSearch.ShieldWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="YamaShield" Width="520" Height="610" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" Background="#0B101A" Foreground="#EAF3FF">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><DockPanel LastChildFill="False"><TextBlock Text="◈  YamaShield" Foreground="#23C9F5" FontWeight="SemiBold" FontSize="25"/><Button Content="×" DockPanel.Dock="Right" Foreground="#EAF3FF" Click="Cancel_Click"/></DockPanel><TextBlock x:Name="PageState" Margin="0,10,0,0" Foreground="#C5D3E3" TextWrapping="Wrap"/></StackPanel>
   <Border Grid.Row="1" Background="#16243A" CornerRadius="12" Padding="16" Margin="0,22,0,14"><StackPanel><TextBlock Text="Úroveň ochrany" FontSize="17" FontWeight="SemiBold"/><RadioButton x:Name="Recommended" Foreground="#EAF3FF" Content="Doporučená — bezpečné výchozí nastavení" Margin="0,12,0,4" Checked="Level_Checked"/><RadioButton x:Name="Strict" Foreground="#EAF3FF" Content="Přísná — silnější blokování, web může vyžadovat výjimku" Margin="0,4" Checked="Level_Checked"/><RadioButton x:Name="Custom" Foreground="#EAF3FF" Content="Vlastní — nastavit jednotlivé prvky" Margin="0,4" Checked="Level_Checked"/></StackPanel></Border>
    <StackPanel Grid.Row="2"><TextBlock Text="Vlastní ochrana" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,8"/><CheckBox x:Name="SmartScreen" Foreground="#EAF3FF" Content="Microsoft Defender SmartScreen pro weby a stahování" Margin="0,7"/><CheckBox x:Name="PasswordSave" Foreground="#EAF3FF" Content="Nabízet bezpečné ukládání hesel přes WebView2" Margin="0,7"/><TextBlock Text="Hesla se neukládají v nastavení YamaSearch. Spravuje je WebView2/Windows profil. Kontroly neplatných certifikátů nelze vypnout." Foreground="#C5D3E3" TextWrapping="Wrap" Margin="0,15,0,0"/></StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Zrušit" Click="Cancel_Click" Margin="0,0,8,0"/><Button Content="Uložit ochranu" Background="#087EAA" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
