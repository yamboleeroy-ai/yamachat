{
  "id": "./",
  "name": "YamaConvert",
  "short_name": "YamaConvert",
  "description": "Lokální převody souborů. Sdílej audio a video z Androidu do YamaConvert.",
  "lang": "cs",
  "start_url": "./",
  "scope": "./",
  "share_target": {
    "action": "./share/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "mediaFiles",
          "accept": ["audio/*", "video/*", ".mp3", ".wav", ".m4a", ".ogg", ".opus", ".mp4", ".webm", ".mov", ".mkv", ".avi"]
        }
      ]
    }
  },
  "display": "standalone",
  "orientation": "any",
  "background_color": "#080b18",
  "theme_color": "#080b18",
  "icons": [
    { "src": "icons/yamaconvert-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/yamaconvert-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/yamaconvert.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
