<Window x:Class="YamaSearch.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktualizace YamaSearch"
        Icon="pack://application:,,,/Assets/YamaSearch.ico"
        Width="560" Height="360" MinWidth="520" MinHeight="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel>
      <Image Source="pack://application:,,,/Assets/YamaSearch-symbol-64.png"
             Width="52" Height="52" Margin="0,0,14,0"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Je dostupná nová verze YamaSearch"
                   FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText"
                   Foreground="{DynamicResource AccentBrush}"
                   Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="#294465" BorderThickness="1"
            CornerRadius="10" Padding="14" Margin="0,18,0,0">
      <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextBrush}"/>
    </Border>

    <TextBlock Grid.Row="2" x:Name="ModeText"
               Foreground="{DynamicResource MutedBrush}"
               TextWrapping="Wrap"
               Margin="2,16,2,0"/>

    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" Content="Nainstalovat aktualizaci"
              Background="#0C4051" BorderBrush="#22D3EE"
              BorderThickness="1" Padding="14,9"
              Click="Installer_Click"/>
      <Button Grid.Column="2" Content="Portable ZIP"
              Margin="8,0,0,0" Background="#182A43"
              Padding="14,9" Click="Portable_Click"/>
      <Button Grid.Column="3" Content="Později"
              Margin="8,0,0,0" Padding="14,9"
              Click="Later_Click"/>
    </Grid>
  </Grid>
</Window>