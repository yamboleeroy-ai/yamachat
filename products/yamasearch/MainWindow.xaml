<Window x:Class="YamaSearch.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="YamaSearch" Icon="pack://application:,,,/Assets/YamaSearch.ico" Width="1440" Height="920" MinWidth="960" MinHeight="650" Background="{DynamicResource WindowBrush}" WindowStyle="None" ResizeMode="CanResize" Loaded="Window_Loaded">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome x:Name="AppWindowChrome"
                        CaptionHeight="0"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="ToolbarShieldButton" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Background" Value="#142238"/>
      <Setter Property="BorderBrush" Value="#31537D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#7DDFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ShieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ShieldBorder" Property="Background" Value="#1B304B"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ShieldBorder" Property="Opacity" Value=".82"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkTabMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="#EAF3FF"/><Setter Property="Background" Value="#101D30"/>
      <Setter Property="Padding" Value="13,9"/><Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuItemBorder" Property="Background" Value="#21496B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuItemBorder" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidePanelScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Background" Value="#0B1624"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Background="#1EC8F2" BorderBrush="#65E5FF" BorderThickness="1">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SideSectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#7FA8D8"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="4,12,0,7"/>
    </Style>

    <Style x:Key="SideNavButton" TargetType="Button">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="#10233B"/>
      <Setter Property="BorderBrush" Value="#1E527C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#F4F8FF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="#173A5A"/>
                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#2EAEE3"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Opacity" Value=".84"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SideLibraryButton" TargetType="Button" BasedOn="{StaticResource SideNavButton}">
      <Setter Property="Background" Value="#132A46"/>
      <Setter Property="BorderBrush" Value="#245A84"/>
    </Style>

    <Style x:Key="SideDangerButton" TargetType="Button">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Margin" Value="0,4,0,10"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Foreground" Value="#FFD5DC"/>
      <Setter Property="Background" Value="#41212D"/>
      <Setter Property="BorderBrush" Value="#A84E65"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="SideDeleteButton" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="#FFB7C5"/>
      <Setter Property="Background" Value="#3A202B"/>
      <Setter Property="BorderBrush" Value="#6E3345"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="SideCloseButton" TargetType="Button">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#10243A"/>
      <Setter Property="BorderBrush" Value="#245A84"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0" x:Name="PanelColumn"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Background="{DynamicResource SurfaceBrush}" PreviewMouseLeftButtonDown="TitleBar_MouseDown">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Source="pack://application:,,,/Assets/YamaSearch-brand.png" Width="180" Height="54" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,6,0"/>
        <ScrollViewer x:Name="TabsScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" SizeChanged="TabsScroller_SizeChanged"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ItemsControl x:Name="TabsList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><Button Content="＋" ToolTip="Nová karta (Ctrl+T)" Click="NewTab_Click" FontSize="17" Margin="8,8"/></StackPanel></ScrollViewer>
        <Button Grid.Column="2" Content="☰" ToolTip="Historie, oblíbené a funkce" Click="Menu_Click" Margin="0,4"/>
        <Button Grid.Column="3" Content="—" ToolTip="Minimalizovat" Click="Minimize_Click" Margin="0,4"/>
        <Button Grid.Column="4" Content="□" ToolTip="Maximalizovat / obnovit" Click="Maximize_Click" Margin="0,4"/>
        <Button Grid.Column="5" Content="×" ToolTip="Zavřít" Click="Close_Click" Margin="0,4,8,4"/>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Background="#0E1726" BorderBrush="#253A57" BorderThickness="0,1,0,1" Padding="14,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="←" FontSize="18" Click="Back_Click"/><Button Grid.Column="1" Content="→" FontSize="18" Click="Forward_Click"/><Button x:Name="ReloadButton" Grid.Column="2" Content="↻" FontSize="18" Click="Reload_Click"/>
        <Grid Grid.Column="3" Margin="8,0"><TextBox x:Name="AddressBox" VerticalContentAlignment="Center" PreviewKeyDown="AddressBox_PreviewKeyDown" KeyDown="AddressBox_KeyDown" TextChanged="AddressBox_TextChanged" GotKeyboardFocus="AddressBox_GotKeyboardFocus" PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown" ToolTip="Zadejte adresu nebo vyhledávání"/><Popup x:Name="AddressSuggestions" Placement="Custom" CustomPopupPlacementCallback="AddressSuggestions_CustomPopupPlacement" PlacementTarget="{Binding ElementName=AddressBox}" StaysOpen="False" AllowsTransparency="True"><Border x:Name="AddressSuggestionsBorder" Background="#16243A" BorderBrush="#31537D" BorderThickness="1" CornerRadius="0,0,10,10" MinWidth="360" Padding="6"><StackPanel x:Name="AddressSuggestionList"/></Border></Popup></Grid>
        <Button Grid.Column="4" Content="Přejít" Click="Go_Click"/>
        <Button x:Name="FavoritesButton" Grid.Column="5" Content="☆" FontSize="18" ToolTip="Oblíbené" Click="FavoritesButton_Click"/>

        <Button x:Name="HistoryQuickButton" Grid.Column="6" Style="{StaticResource ToolbarShieldButton}" ToolTip="Historie" Click="HistoryQuickButton_Click">
          <Viewbox Width="23" Height="23">
            <Grid Width="24" Height="24">
              <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Margin="2"/>
              <Path Data="M12,6 L12,12 L16,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
          </Viewbox>
        </Button>

        <Button x:Name="DownloadButton" Grid.Column="7" Style="{StaticResource ToolbarShieldButton}" ToolTip="Stahování" Click="DownloadButton_Click">
          <Grid Width="24" Height="24" ClipToBounds="True">
            <Border x:Name="DownloadProgressFill" Height="0" VerticalAlignment="Bottom" Background="#2358D8A8" CornerRadius="4" Opacity=".8"/>
            <Viewbox x:Name="DownloadArrowIcon" Width="23" Height="23">
              <Grid Width="24" Height="24">
                <Path Data="M12,3 L12,15 M7.5,11 L12,15.5 L16.5,11 M5,20 L19,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Grid>
            </Viewbox>
            <TextBlock x:Name="DownloadCheckMark" Text="✓" FontSize="22" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
        </Button>

        <Button x:Name="ShieldButton" Grid.Column="8" Style="{StaticResource ToolbarShieldButton}" ToolTip="YamaShield" Click="ShieldButton_Click">
          <Viewbox Width="23" Height="23">
            <Grid Width="24" Height="24">
              <Path Data="M12,2 L20,5 V10.6 C20,16.1 16.8,20 12,22 C7.2,20 4,16.1 4,10.6 V5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
              <Path Data="M8.8,11.9 L11,14.1 L15.7,9.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
          </Viewbox>
        </Button>
        <Button x:Name="BlockButton" Grid.Column="9" Style="{StaticResource ToolbarShieldButton}" ToolTip="YamaBlock" Click="BlockButton_Click">
          <Viewbox Width="23" Height="23">
            <Grid Width="24" Height="24">
              <Path Data="M12,2 L20,5 V10.6 C20,16.1 16.8,20 12,22 C7.2,20 4,16.1 4,10.6 V5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round"/>
              <Path Data="M12,7 L16,11 L12,15 L8,11 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Grid>
          </Viewbox>
        </Button>

        <Popup x:Name="FavoritesQuickPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=FavoritesButton}" StaysOpen="False" AllowsTransparency="True">
          <Border Background="#101A29" BorderBrush="#31537D" BorderThickness="1" CornerRadius="12" Width="330" Padding="12" Margin="0,6,0,0">
            <StackPanel>
              <TextBlock Text="Oblíbené" FontSize="16" FontWeight="SemiBold" Foreground="#EAF3FF" Margin="2,0,2,8"/>
              <Button x:Name="FavoriteCurrentPageButton" Content="☆ Přidat aktuální stránku" HorizontalContentAlignment="Left" Background="#182A43" Click="FavoriteCurrentPage_Click" Margin="0,2"/>
              <CheckBox x:Name="ShowFavoritesBarCheckBox" Content="Zobrazit lištu oblíbených" Foreground="#EAF3FF" Margin="8,10,8,4" Click="ShowFavoritesBarCheckBox_Click"/>
              <TextBlock Text="Když je zapnutá, lišta zůstane pod adresním řádkem." Foreground="#8FA4BE" FontSize="11" TextWrapping="Wrap" Margin="8,0,8,8"/>
              <Button Content="Spravovat oblíbené" HorizontalContentAlignment="Center" Background="#182A43" Click="ManageFavorites_Click"/>
            </StackPanel>
          </Border>
        </Popup>

        <Popup x:Name="HistoryQuickPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=HistoryQuickButton}" StaysOpen="False" AllowsTransparency="True">
          <Border Background="#101A29" BorderBrush="#31537D" BorderThickness="1" CornerRadius="12" Width="390" Padding="12" Margin="0,6,0,0">
            <StackPanel>
              <DockPanel Margin="2,0,2,8"><TextBlock Text="Historie" FontSize="16" FontWeight="SemiBold" Foreground="#EAF3FF"/><TextBlock Text="poslední návštěvy" DockPanel.Dock="Right" Foreground="#7794B5" FontSize="11" VerticalAlignment="Center"/></DockPanel>
              <StackPanel x:Name="HistoryQuickList"/>
              <Button Content="Zobrazit vše" HorizontalContentAlignment="Center" Margin="0,10,0,0" Background="#182A43" Click="ShowAllHistory_Click"/>
            </StackPanel>
          </Border>
        </Popup>

        <Popup x:Name="DownloadPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=DownloadButton}" StaysOpen="False" AllowsTransparency="True">
          <Border Background="#101A29" BorderBrush="#31537D" BorderThickness="1" CornerRadius="12" Width="410" Padding="12" Margin="0,6,0,0">
            <StackPanel>
              <DockPanel Margin="2,0,2,8"><TextBlock Text="Stahování" FontSize="16" FontWeight="SemiBold" Foreground="#EAF3FF"/><TextBlock x:Name="DownloadPopupStatus" DockPanel.Dock="Right" Foreground="#7794B5" FontSize="11" VerticalAlignment="Center"/></DockPanel>
              <StackPanel x:Name="DownloadQuickList"/>
              <Button Content="Zobrazit vše" HorizontalContentAlignment="Center" Margin="0,10,0,0" Background="#182A43" Click="ShowAllDownloads_Click"/>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </Border>
    <Border x:Name="FavoritesBar" Grid.Row="2" Background="#0D1624" BorderBrush="#253A57" BorderThickness="0,0,0,1" Padding="12,5" Visibility="Collapsed" SizeChanged="FavoritesBar_SizeChanged">
      <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="FavoritesBarItems" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True"/>
        <Button x:Name="FavoritesOverflowButton" Grid.Column="1" Content="•••" ToolTip="Další oblíbené" Visibility="Collapsed" Margin="6,0,0,0" Padding="10,4" Click="FavoritesOverflowButton_Click"/>
        <Popup x:Name="FavoritesOverflowPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=FavoritesOverflowButton}" StaysOpen="False" AllowsTransparency="True">
          <Border Background="#101A29" BorderBrush="#31537D" BorderThickness="1" CornerRadius="10" Width="320" Padding="8" Margin="0,5,0,0">
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="FavoritesOverflowList"/>
            </ScrollViewer>
          </Border>
        </Popup>
      </Grid>
    </Border>
    <Grid x:Name="BrowserHost" Grid.Row="3" Background="{DynamicResource WindowBrush}"/>
    <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" Padding="12,4"><DockPanel LastChildFill="False"><TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="BlockedText" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}"/></DockPanel></Border>
    <Border Grid.Column="1" Grid.RowSpan="5" x:Name="SidePanel"
            Background="#0B1624" BorderBrush="#15486D" BorderThickness="1,0,0,0"
            Visibility="Collapsed">
      <Grid Margin="20,18,14,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image Source="pack://application:,,,/Assets/YamaSearch-brand.png"
                 Width="230" Height="66" Stretch="Uniform" HorizontalAlignment="Left"/>
          <Button Grid.Column="1" Style="{StaticResource SideCloseButton}" Content="×" ToolTip="Zavřít menu" Click="Menu_Click" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SidePanelScrollBar}"/>
          </ScrollViewer.Resources>
          <StackPanel Margin="0,2,4,10">

            <DockPanel Margin="4,4,0,5">
              <TextBlock Text="RYCHLÉ AKCE" Style="{StaticResource SideSectionLabel}" Margin="0"/>
              <Border Height="1" Background="#2B678E" Margin="14,8,0,0" DockPanel.Dock="Right" Width="205"/>
            </DockPanel>

            <Button Style="{StaticResource SideNavButton}" Click="NewTab_Click">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="＋" Foreground="#42D8FF" FontSize="19" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Nová karta" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Ctrl+T" Foreground="#9EB8D4" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Style="{StaticResource SideNavButton}" Click="NewWindow_Click">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="▣" Foreground="#42D8FF" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Nové okno" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Ctrl+N" Foreground="#9EB8D4" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Style="{StaticResource SideNavButton}" Click="FindOnPage_Click">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="⌕" Foreground="#42D8FF" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Najít na stránce" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Ctrl+F" Foreground="#9EB8D4" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Style="{StaticResource SideNavButton}" Click="PrintPage_Click">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="▤" Foreground="#42D8FF" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Tisk" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Ctrl+P" Foreground="#9EB8D4" VerticalAlignment="Center"/>
              </Grid>
            </Button>

            <DockPanel Margin="4,13,0,5">
              <TextBlock Text="DALŠÍ NÁSTROJE" Style="{StaticResource SideSectionLabel}" Margin="0"/>
              <Border Height="1" Background="#2B678E" Margin="14,8,0,0" DockPanel.Dock="Right" Width="180"/>
            </DockPanel>

            <Button Style="{StaticResource SideNavButton}" Click="CreateSiteApp_Click">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="⊞" Foreground="#42D8FF" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Vytvořit aplikaci této stránky" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Style="{StaticResource SideNavButton}" Click="DownloadsPanel_Click">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="⇩" Foreground="#42D8FF" FontSize="19" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Stahování" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Style="{StaticResource SideNavButton}" Click="Settings_Click">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="⚙" Foreground="#42D8FF" FontSize="17" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Nastavení" VerticalAlignment="Center"/>
              </Grid>
            </Button>

            <DockPanel Margin="4,13,0,5">
              <TextBlock Text="KNIHOVNA" Style="{StaticResource SideSectionLabel}" Margin="0"/>
              <Border Height="1" Background="#2B678E" Margin="14,8,0,0" DockPanel.Dock="Right" Width="230"/>
            </DockPanel>

            <Button Style="{StaticResource SideLibraryButton}" Click="ShieldButton_Click">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="◈" Foreground="#55E3FF" FontSize="17" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="YamaShield" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="›" Foreground="#BBD4EC" FontSize="20" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Style="{StaticResource SideLibraryButton}" Click="BookmarksPanel_Click">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="☆" Foreground="#55E3FF" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Oblíbené" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="›" Foreground="#BBD4EC" FontSize="20" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Style="{StaticResource SideLibraryButton}" Click="HistoryPanel_Click">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="◷" Foreground="#55E3FF" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Historie" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="›" Foreground="#BBD4EC" FontSize="20" VerticalAlignment="Center"/>
              </Grid>
            </Button>

            <Border Height="1" Background="#2B678E" Margin="4,16,0,14"/>

            <DockPanel Margin="4,0,0,7">
              <TextBlock x:Name="PanelTitle" Foreground="#F1F7FF" FontWeight="SemiBold" FontSize="19"/>
            </DockPanel>
            <ItemsControl x:Name="PanelList" Margin="0,2,0,6"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
