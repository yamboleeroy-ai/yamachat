<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.18362.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.3.30</Version>
    <AssemblyVersion>0.3.30.0</AssemblyVersion>
    <FileVersion>0.3.30.0</FileVersion>
    <ApplicationIcon>Assets\YamaSearch.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <!-- Override the toolkit's legacy 4.7.0 transitive dependency, which carries
         CVE-2021-24112, with the serviced .NET 8 line used by this application. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.34" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\YamaSearch-logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\YamaSearch-brand.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\YamaSearch-symbol-256.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\YamaSearch-wordmark.png" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\YamaSearch-logo.png" />
    <Resource Include="Assets\YamaSearch-brand.png" />
    <Resource Include="Assets\YamaSearch-symbol-64.png" />
    <Resource Include="Assets\YamaSearch-wordmark.png" />
    <Resource Include="Assets\YamaSearch.ico" />
    <Content Include="portal-account-backend.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="account-backend.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('account-backend.json')" />
  </ItemGroup>
</Project>
