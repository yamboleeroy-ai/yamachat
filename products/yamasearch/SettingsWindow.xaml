<Window x:Class="YamaSearch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nastavení YamaSearch"
        Width="700" Height="790" MinWidth="640" MinHeight="700"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#08111D" Foreground="#EAF3FF"
        Icon="pack://application:,,,/Assets/YamaSearch.ico">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#174B70" BorderThickness="1" CornerRadius="14" Background="#08111D">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/Assets/YamaSearch-symbol-64.png" Width="42" Height="42" Margin="0,0,12,0"/>
          <StackPanel>
            <TextBlock Text="Nastavení YamaSearch" FontSize="22" FontWeight="SemiBold" Foreground="#42D8FF"/>
            <TextBlock Text="Vzhled, výkon, vyhledávání a přihlašování" Style="{StaticResource YamaSubtleText}" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="×" Style="{StaticResource YamaCloseButton}" Click="Close_Click"/>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource YamaScrollBar}"/></ScrollViewer.Resources>
        <StackPanel Margin="0,0,8,0">

          <Border Style="{StaticResource YamaDialogCard}">
            <StackPanel>
              <TextBlock Text="Vyhledávání a domovská stránka" Style="{StaticResource YamaSectionTitle}"/>
              <TextBlock Text="Výchozí vyhledávač" Style="{StaticResource YamaSubtleText}" Margin="0,14,0,5"/>
              <ComboBox x:Name="SearchEngine" Style="{StaticResource YamaComboBox}" Height="42">
                <ComboBoxItem Content="Google"/><ComboBoxItem Content="Seznam"/><ComboBoxItem Content="Bing"/>
                <ComboBoxItem Content="DuckDuckGo"/><ComboBoxItem Content="Brave Search"/><ComboBoxItem Content="Ecosia"/>
                <ComboBoxItem Content="Yahoo"/><ComboBoxItem Content="Startpage"/>
              </ComboBox>

              <TextBlock Text="Domovská stránka" Style="{StaticResource YamaSubtleText}" Margin="0,14,0,5"/>
              <ComboBox x:Name="HomePage" Style="{StaticResource YamaComboBox}" Height="42">
                <ComboBoxItem Content="YamaSearch — nová karta"/><ComboBoxItem Content="Google"/>
                <ComboBoxItem Content="Seznam"/><ComboBoxItem Content="Vlastní URL"/>
              </ComboBox>
              <TextBox x:Name="CustomHome" Text="https://" Style="{StaticResource YamaTextBox}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource YamaDialogCard}">
            <StackPanel>
              <TextBlock Text="Výkon" Style="{StaticResource YamaSectionTitle}"/>
              <CheckBox x:Name="HardwareAcceleration" Style="{StaticResource YamaCheckBox}"
                        Content="Používat hardwarovou akceleraci, když je dostupná"
                        Margin="0,14,0,8"/>
              <TextBlock Text="Doporučeno zapnout. WebView2 pak používá GPU pro vykreslování webu a videa. Změna se projeví po restartu YamaSearch."
                         Style="{StaticResource YamaSubtleText}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource YamaDialogCard}">
            <StackPanel>
              <TextBlock Text="Hesla a přihlašování" Style="{StaticResource YamaSectionTitle}"/>
              <CheckBox x:Name="OfferPasswordSave" Style="{StaticResource YamaCheckBox}"
                        Content="Nabízet bezpečné ukládání hesel" Margin="0,14,0,8"/>
              <TextBlock Text="Hesla se nikdy nezobrazují ani nekopírují. Spravuje je bezpečný profil WebView2/Windows."
                         Style="{StaticResource YamaSubtleText}"/>
              <Button Content="Smazat všechna uložená hesla" Style="{StaticResource YamaDangerButton}"
                      HorizontalAlignment="Left" Margin="0,14,0,0" Click="DeletePasswords_Click"/>
              <TextBlock Text="Poznámka: WebView2 zatím neposkytuje bezpečné veřejné API pro výpis a smazání jednoho konkrétního uloženého hesla podle webu. YamaSearch proto nebude sahat přímo do interní databáze hesel, aby nehrozilo její poškození."
                         Style="{StaticResource YamaSubtleText}" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource YamaDialogCard}">
            <StackPanel>
              <TextBlock Text="Soukromí a zabezpečení · oprávnění webů" Style="{StaticResource YamaSectionTitle}"/>
              <CheckBox x:Name="BlockNewNotificationRequests" Style="{StaticResource YamaCheckBox}"
                        Content="Globálně blokovat nové žádosti o oznámení" Margin="0,14,0,8"/>
              <TextBlock Text="Už povolené weby se nemění. Jejich oprávnění lze jednotlivě obnovit v přehledu níže."
                         Style="{StaticResource YamaSubtleText}"/>
              <Button Content="Spravovat oprávnění webů" Style="{StaticResource YamaSecondaryButton}"
                      HorizontalAlignment="Left" Margin="0,14,0,0" Click="ManagePermissions_Click"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource YamaDialogCard}">
            <StackPanel>
              <TextBlock Text="Další nástroje" Style="{StaticResource YamaSectionTitle}"/>
              <TextBlock Text="Nová karta, nové okno, tisk, hledání na stránce a vytvoření aplikace z aktuálního webu najdeš v hlavním menu YamaSearch."
                         Style="{StaticResource YamaSubtleText}" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Některé změny mohou vyžadovat restart." Style="{StaticResource YamaSubtleText}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="Zrušit" Style="{StaticResource YamaSecondaryButton}" Click="Close_Click" Margin="0,0,8,0"/>
        <Button Grid.Column="2" Content="Uložit" Style="{StaticResource YamaPrimaryButton}" Click="Save_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
