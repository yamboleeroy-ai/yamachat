<Window x:Class="YamaSearch.AppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YamaSearch – Aplikace"
        Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#08111D" Foreground="#EAF3FF"
        Icon="pack://application:,,,/Assets/YamaSearch.ico">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#174B70" BorderThickness="1" CornerRadius="14" Background="#08111D">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Grid Background="#0D1828" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/Assets/YamaSearch-symbol-64.png" Width="34" Height="34" Margin="0,0,10,0"/>
          <TextBlock Text="YamaSearch · Aplikace" Foreground="#42D8FF" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1" Content="×" Style="{StaticResource YamaCloseButton}" Click="Close_Click" Margin="0,8,10,8"/>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="#0D1828" BorderBrush="#174B70" BorderThickness="0,1,1,0">
          <StackPanel Margin="20">
            <TextBlock Text="APLIKACE" Foreground="#7FA8D8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Button Content="☷  Všechny aplikace" Style="{StaticResource YamaSecondaryButton}" HorizontalContentAlignment="Left" Click="ShowAll_Click" Margin="0,0,0,8"/>
            <Button Content="▦  Nainstalované aplikace" Style="{StaticResource YamaSecondaryButton}" HorizontalContentAlignment="Left" Click="ShowInstalled_Click" Margin="0,0,0,8"/>
            <Button Content="⊞  Aplikace na jiných zařízeních" Style="{StaticResource YamaSecondaryButton}" HorizontalContentAlignment="Left" IsEnabled="False"/>
            <Border Height="1" Background="#245A84" Margin="0,18,0,18"/>
            <TextBlock Text="Nainstalované" Style="{StaticResource YamaSubtleText}" Margin="0,0,0,8"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="430">
              <StackPanel x:Name="AppList"/>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource YamaScrollBar}"/></ScrollViewer.Resources>
          <Grid Margin="36,28,44,36">
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="Zatím nejsou nainstalované žádné webové aplikace." FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="Otevři web a v menu YamaSearch použij „Vytvořit aplikaci této stránky“." Style="{StaticResource YamaSubtleText}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="DetailPanel">
              <TextBlock x:Name="BreadcrumbText" Text="Všechny aplikace" Foreground="#A9BDD5" FontSize="13" Margin="0,0,0,18"/>

              <Border Style="{StaticResource YamaDialogCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="60" Height="60" CornerRadius="14" Background="#10243A" BorderBrush="#245A84" BorderThickness="1">
                    <Image x:Name="DetailIcon" Width="46" Height="46" Stretch="Uniform"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailName" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DetailPublisher" Style="{StaticResource YamaSubtleText}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="2" Content="Otevřít" Style="{StaticResource YamaPrimaryButton}" Click="OpenApp_Click" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource YamaDialogCard}">
                <StackPanel>
                  <TextBlock Text="Oprávnění" Style="{StaticResource YamaSectionTitle}"/>
                  <TextBlock Text="Webová aplikace používá stejná oprávnění webu jako při běžném otevření v YamaSearch. Kamera, mikrofon, poloha a další citlivá oprávnění stále kontroluje YamaShield."
                             Style="{StaticResource YamaSubtleText}" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource YamaDialogCard}">
                <StackPanel>
                  <TextBlock Text="Integrace s Windows" Style="{StaticResource YamaSectionTitle}"/>
                  <CheckBox x:Name="StartMenuCheck" Style="{StaticResource YamaCheckBox}" Content="Přidat do nabídky Start" Margin="0,14,0,8" Checked="IntegrationChanged" Unchecked="IntegrationChanged"/>
                  <CheckBox x:Name="DesktopCheck" Style="{StaticResource YamaCheckBox}" Content="Vytvořit zástupce na ploše" Margin="0,8" Checked="IntegrationChanged" Unchecked="IntegrationChanged"/>
                  <CheckBox x:Name="StartupCheck" Style="{StaticResource YamaCheckBox}" Content="Automaticky spouštět při přihlášení do Windows" Margin="0,8" Checked="IntegrationChanged" Unchecked="IntegrationChanged"/>
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Připnout na hlavní panel" Style="{StaticResource YamaSecondaryButton}" Click="PinTaskbar_Click" Margin="0,0,8,0"/>
                    <Button Content="Otevřít umístění zástupce" Style="{StaticResource YamaSecondaryButton}" Click="OpenShortcutLocation_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="IntegrationStatus" Style="{StaticResource YamaSubtleText}" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource YamaDialogCard}">
                <StackPanel>
                  <TextBlock Text="Informace o aplikaci" Style="{StaticResource YamaSectionTitle}"/>
                  <TextBlock x:Name="AppUrlText" Foreground="#BBD0E8" Margin="0,12,0,0" TextWrapping="Wrap"/>
                  <TextBlock x:Name="InstalledText" Style="{StaticResource YamaSubtleText}" Margin="0,6,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Odinstalovat" Style="{StaticResource YamaDangerButton}" Click="Uninstall_Click"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
