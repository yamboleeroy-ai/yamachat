<Window x:Class="YamaSearch.FindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Najít na stránce"
        Width="500" Height="230"
        ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="#08111D" Foreground="#EAF3FF"
        Icon="pack://application:,,,/Assets/YamaSearch.ico">
  <Border BorderBrush="#174B70" BorderThickness="1" CornerRadius="14" Background="#08111D">
    <Grid Margin="20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="⌕" Foreground="#42D8FF" FontSize="24" Margin="0,0,10,0"/>
          <StackPanel>
            <TextBlock Text="Najít na stránce" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Vyhledej text na aktuálním webu" Style="{StaticResource YamaSubtleText}"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="×" Style="{StaticResource YamaCloseButton}" Click="Cancel_Click"/>
      </Grid>
      <Border Grid.Row="1" Style="{StaticResource YamaDialogCard}" Margin="0,16,0,14">
        <StackPanel>
          <TextBlock Text="Hledaný text" Style="{StaticResource YamaSubtleText}" Margin="0,0,0,5"/>
          <TextBox x:Name="QueryBox" Style="{StaticResource YamaTextBox}" KeyDown="QueryBox_KeyDown"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Zrušit" Style="{StaticResource YamaSecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0"/>
        <Button Content="Najít" Style="{StaticResource YamaPrimaryButton}" Click="Find_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>