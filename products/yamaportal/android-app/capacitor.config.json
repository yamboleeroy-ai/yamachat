{
  "appId": "eu.yamaportal.app",
  "appName": "Yamaportal",
  "webDir": "www",
  "backgroundColor": "#030a17",
  "server": { "androidScheme": "https" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 650, "launchAutoHide": true, "backgroundColor": "#030a17", "showSpinner": false },
    "StatusBar": { "overlaysWebView": false, "backgroundColor": "#030a17", "style": "LIGHT" },
    "Keyboard": { "resize": "native", "resizeOnFullScreen": true },
    "SecureStorage": { "keyPrefix": "yamaportal-auth-v1-" }
  }
}
