<Window x:Class="YamaSearch.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Aktualizace YamaSearch" Icon="pack://application:,,,/Assets/YamaSearch.ico"
        Width="620" Height="430" MinWidth="580" MinHeight="400"
        ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="#08111D" Foreground="#EAF3FF">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#174B70" BorderThickness="1" CornerRadius="14" Background="#08111D">
    <Grid Margin="24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/Assets/YamaSearch-symbol-64.png" Width="52" Height="52" Margin="0,0,14,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Aktualizace YamaSearch" FontSize="21" FontWeight="SemiBold" Foreground="#42D8FF"/>
            <TextBlock x:Name="VersionText" Foreground="#9CB4CF" Margin="0,4,0,0"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="×" Style="{StaticResource YamaCloseButton}" Click="Later_Click"/>
      </Grid>

      <Border Grid.Row="1" Style="{StaticResource YamaDialogCard}" Margin="0,18,0,12">
        <StackPanel>
          <TextBlock Text="Co je nového" Style="{StaticResource YamaSectionTitle}" Margin="0,0,0,8"/>
          <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="#DDEAFF"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Background="#0E1A2B" BorderBrush="#245A84" BorderThickness="1" CornerRadius="12" Padding="14">
        <TextBlock x:Name="ModeText" Foreground="#9CB4CF" TextWrapping="Wrap"/>
      </Border>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="Později" Style="{StaticResource YamaSecondaryButton}" Click="Later_Click" Margin="0,0,8,0"/>
        <Button Content="Portable ZIP" Style="{StaticResource YamaSecondaryButton}" Click="Portable_Click" Margin="0,0,8,0"/>
        <Button Content="Nainstalovat aktualizaci" Style="{StaticResource YamaPrimaryButton}" Click="Installer_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>