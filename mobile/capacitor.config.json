{
  "appId": "eu.yamachat.app",
  "appName": "Yamachat",
  "webDir": "www",
  "backgroundColor": "#071019",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": false,
      "backgroundColor": "#071019",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#071019",
      "style": "LIGHT"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
