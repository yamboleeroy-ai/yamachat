<Window x:Class="YamaSearch.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YamaSearch – Historie stahování"
        Icon="pack://application:,,,/Assets/YamaSearch.ico"
        Width="900" Height="650" MinWidth="700" MinHeight="480"
        Background="#0B101A" Foreground="#EAF3FF"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Historie stahování" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Text="Stažené soubory, průběh a předchozí stahování" Foreground="#96A7BD" Margin="0,4,0,0"/>
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="Vymazat historii" Click="ClearHistory_Click"
              Background="#3A202A" BorderBrush="#68404D" BorderThickness="1"
              Foreground="#FFD3DB" Padding="14,8" VerticalAlignment="Center"/>
    </DockPanel>

    <Border Grid.Row="1" Background="#101A29" BorderBrush="#294465" BorderThickness="1" CornerRadius="12" Padding="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DownloadList"/>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="2" Text="Vymazání historie neodstraní stažené soubory z disku."
               Foreground="#7794B5" Margin="4,12,0,0"/>
  </Grid>
</Window>