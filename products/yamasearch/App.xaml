<Application x:Class="YamaSearch.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Startup="Application_Startup">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#0B101A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121A27"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#192437"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EAF3FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#96A7BD"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#23C9F5"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#253650"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/><Setter Property="BorderBrush" Value="#2B4262"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="1"/></Style>
  </Application.Resources>
</Application>
